###############################################################################
# Career CRM Environment Configuration
#
# Copy this file to .env and replace the placeholder values.
#
# Never commit your .env file to Git.
###############################################################################

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

APP_ENV=development

# Generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://careercrm:password@localhost:5432/career_crm
#
# Remote PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://careercrm:password@192.168.4.27:5432/career_crm
DATABASE_URL=postgresql+psycopg://careercrm:change-me@localhost:5432/career_crm

# ---------------------------------------------------------------------------
# File Uploads
# ---------------------------------------------------------------------------

# Development
UPLOAD_FOLDER=uploads

# Production example:
# UPLOAD_FOLDER=/srv/career-crm/uploads

MAX_UPLOAD_SIZE=16777216

# ---------------------------------------------------------------------------
# Credential Encryption
# ---------------------------------------------------------------------------

# Used to encrypt user API credentials (OpenAI, Anthropic, etc.)
#
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Never change this value after users begin storing encrypted credentials
# unless you also migrate/re-encrypt all stored secrets.
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# ---------------------------------------------------------------------------
# AI Configuration
# ---------------------------------------------------------------------------

# Default provider used if a user has not selected one.
#
# Supported values (future):
# deterministic
# openai
# anthropic
# ollama
# lmstudio
AI_PROVIDER=deterministic

# Default model used when applicable.
AI_MODEL=gpt-5.5

# Optional server-owned AI account.
#
# Leave these unset when users provide their own API keys through
# Career CRM's AI Settings page.
#
# AI_API_URL=https://api.openai.com/v1/responses
# AI_API_KEY=

# ---------------------------------------------------------------------------
# Future Integrations
# ---------------------------------------------------------------------------

# Redis
# REDIS_URL=redis://localhost:6379/0

# Email
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------

# When running under Docker Compose these values may be overridden by the
# compose environment configuration.
#
# APP_ENV=production
#
# DATABASE_URL=postgresql+psycopg://careercrm:password@postgres:5432/career_crm
#
# UPLOAD_FOLDER=/var/lib/career-crm/uploads